<?xml version="1.0" encoding="utf-8"?>
<!-- Copia de seguridad automática de Android (API 31+).
     Incluye la base de datos Room (ferro.db) y DataStore Preferences en la copia en la nube de Google,
     y añade todo filesDir (incluidas fotos de progreso y copias locales) en la transferencia directa
     de móvil a móvil. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="ferro.db" />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="ferro.db" />
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
